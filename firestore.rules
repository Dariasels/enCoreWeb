rules_version = '2';

// Security rules for the enCore Firestore database.
//
// HOW TO APPLY (one-time, ~2 minutes):
//   Firebase console (https://console.firebase.google.com)
//   -> project "encore-v2" -> Firestore Database -> Rules
//   -> paste this whole file -> Publish
//
// Without published rules, anyone on the internet can read AND rewrite
// your entire database. These rules make it safe:
//   - race info, likes and attendance are public to read
//   - only logged-in users can vote ("likes") or join ("going")
//   - users can only edit their own profile
//   - chat messages can't be written in someone else's name

service cloud.firestore {
  match /databases/{database}/documents {

    // User profiles
    match /users/{userId} {
      // Logged-in users can see each other's profiles (names, avatars)
      allow read: if request.auth != null;
      // You can only create/edit/delete your own profile
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Races / events
    match /events/{eventId} {
      // Anyone (also logged-out visitors) may see races, likes, who's going
      allow read: if true;

      // Logged-in users may create a race doc (first like/join creates it)
      allow create: if request.auth != null;

      // Updates may only touch the social fields, nothing else
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['likes', 'going']);

      allow delete: if false;

      // Race chat
      match /chats/{chatId} {
        allow read: if request.auth != null;
        // You can only post as yourself
        allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
        allow update, delete: if false;
      }
    }
  }
}
